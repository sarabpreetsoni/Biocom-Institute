VITE_APP_NAME="Biocom Institute"

# Supabase Backend Configuration
# 1. Create a project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy your Project URL and anon public key here:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Admin Dashboard Password (REQUIRED — change before deploying!)
# Access the admin dashboard at: yoursite.com/admin
VITE_ADMIN_PASSWORD=change-me-to-a-strong-password
