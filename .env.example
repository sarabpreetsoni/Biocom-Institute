# Biocom Institute Firebase Backend Configuration
# 1. Create a Firebase Project at https://console.firebase.google.com/
# 2. Add a Web App in Project Settings -> General -> Your apps
# 3. Enable Authentication (Google Sign-In), Cloud Firestore, and Cloud Storage
# 4. Copy the config values here:

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=

# Collection prefix (defaults to 'biocom-institute-app')
VITE_APP_ID=biocom-institute-app
